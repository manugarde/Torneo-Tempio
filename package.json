{
  "name": "torneo-tempio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-torneo --only firestore,auth \"vitest run --config vitest.rules.config.js\"",
    "emulatori": "firebase emulators:start --project demo-torneo --only firestore,auth",
    "dev:emu": "vite --mode emu",
    "seed": "node scripts/seed.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "firebase-tools": "^15.37.0",
    "svelte": "^5.57.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "dompurify": "3.2.6",
    "firebase": "^12.19.0",
    "quill": "2.0.3"
  }
}
